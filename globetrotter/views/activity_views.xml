<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Activity Tree View -->
    <record id="view_globetrotter_activity_tree" model="ir.ui.view">
        <field name="name">globetrotter.activity.tree</field>
        <field name="model">globetrotter.activity</field>
        <field name="arch" type="xml">
            <tree string="Activities &amp; Experiences">
                <field name="name"/>
                <field name="city_id"/>
                <field name="category" widget="badge"/>
                <field name="duration_hours" string="Duration (h)"/>
                <field name="estimated_cost" widget="monetary" options="{'currency_field': 'currency'}"/>
                <field name="popularity" widget="progressbar"/>
                <field name="currency" invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- Activity Form View -->
    <record id="view_globetrotter_activity_form" model="ir.ui.view">
        <field name="name">globetrotter.activity.form</field>
        <field name="model">globetrotter.activity</field>
        <field name="arch" type="xml">
            <form string="Experience">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Activity Name"/>
                        <h1><field name="name" placeholder="e.g. Amber Palace Sunset Tour"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="city_id"/>
                            <field name="category"/>
                            <field name="location_name"/>
                        </group>
                        <group>
                            <field name="duration_hours"/>
                            <field name="estimated_cost"/>
                            <field name="currency"/>
                            <field name="popularity"/>
                            <field name="image"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action Window for Activities -->
    <record id="action_globetrotter_activities" model="ir.actions.act_window">
        <field name="name">Activities &amp; Experiences</field>
        <field name="res_model">globetrotter.activity</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_globetrotter_activity_list"
              name="Catalog Experiences"
              parent="menu_globetrotter_activities"
              action="action_globetrotter_activities"
              sequence="1"/>
</odoo>
